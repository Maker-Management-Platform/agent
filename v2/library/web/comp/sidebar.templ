package comp

templ SideBar() {
	<aside
		hx-target="#right-aside"
		hx-swap-oob="true"
		class="flex flex-row-reverse mt-1"
	>
		<div class="flex flex-col bg-blue-400">
			<button
				class="btn btn-sm"
				hx-get="/lib/details"
				hx-include="#asset-id"
				hx-target="#asset-sidebar"
			>d</button>
			<button
				class="btn btn-sm"
				hx-get="/lib/edit"
				hx-include="#asset-id"
				hx-target="#asset-sidebar"
			>e</button>
			<button
				class="btn btn-sm"
				hx-get="/lib/new"
				hx-include="#asset-id"
				hx-target="#asset-sidebar"
			>+</button>
			<button class="btn btn-sm">b</button>
			<button class="btn btn-sm">b</button>
		</div>
		<div class="flex" id="asset-sidebar"></div>
	</aside>
}
