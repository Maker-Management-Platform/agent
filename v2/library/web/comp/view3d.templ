package comp

templ View3D() {
	<div class="flex flex-col w-96" :class="tab == 'viewer' ? '' : 'hidden'">
		<p>3D Viewer</p>
		<button type="button" class="btn close"></button>
		<div
			class="h-72 viewer-container bg-slate-400"
			x-ref="viewerContainer"
			hx-preserve="true"
		></div>
		<div class="model-list"></div>
	</div>
}
