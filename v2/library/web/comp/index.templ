package comp

import "github.com/eduardooliveira/stLib/v2/utils"

templ Index(model IndexModel) {
	<div class="h-full w-full flex flex-col asset-view pl-2">
		<input class="hidden" type="text" id="asset-id" name="assetID" value={ model.Asset.ID }/>
		<div class="header flex flex-row">
			<div class="navbar bg-base-200 rounded-box">
				<div class="flex-1">
					<a class="btn btn-ghost text-xl">{ utils.VoZ(model.Asset.Label) }</a>
				</div>
				@Pagination(model.Pagination)
				<div class="flex-none">
					<button
						class="btn btn-square btn-ghost"
						hx-get="/lib/new"
						hx-include="#asset-id"
						hx-target="#asset-sidebar"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							fill="none"
							viewBox="0 0 24 24"
							class="inline-block h-5 w-5 stroke-current"
						><title>note-plus</title><path d="M19 13C19.7 13 20.37 13.13 21 13.35V9L15 3H5C3.89 3 3 3.89 3 5V19C3 20.11 3.9 21 5 21H13.35C13.13 20.37 13 19.7 13 19C13 15.69 15.69 13 19 13M14 4.5L19.5 10H14V4.5M23 18V20H20V23H18V20H15V18H18V15H20V18H23Z"></path></svg>
					</button>
				</div>
			</div>
		</div>
		<div class="flex-initial">
			@BreadCrumbs(model.Asset.Parent)
		</div>
		<main class="flex flex-auto overflow-y-auto main">
			<div class="flex flex-row flex-auto overflow-y-auto">
				@model.Main
			</div>
			<aside class="bg-base-200" id="asset-sidebar"></aside>
		</main>
	</div>
}
